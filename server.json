{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.amadeuserras/leaseclear-mcp",
  "description": "MCP server for LeaseClear lease Q&A.",
  "repository": {
    "url": "https://github.com/amadeuserras/leaseclear-mcp",
    "source": "github"
  },
  "version": "0.1.3",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "leaseclear-mcp",
      "version": "0.1.3",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "LEASECLEAR_API_KEY",
          "description": "Your LeaseClear API key. Omit for demo mode.",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "LEASECLEAR_API_URL",
          "description": "Override the LeaseClear API URL.",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        }
      ]
    }
  ]
}
